Opt-in terminal panic report for the isolated single-vCPU Gunyah monitor.
Requires PL011_UART and UNIXNU_GUNYAH_QUIESCE_SINGLE_CPU.
Not qualified for SMP, asynchronous devices or pass-through.

--- a/osfmk/arm/model_dep.c
+++ b/osfmk/arm/model_dep.c
@@ -1358,17 +1358,30 @@
  * watchdog rebooted the phone. The virtual timer and the GIC CPU interface's Group 1 are turned off first, so no interrupt stays
  * pending to end each WFI at once (the GIC only when this core reaches it through system registers).
  */
+#if defined(UNIXNU_GUNYAH_QUIESCE_SINGLE_CPU)
+extern void PE_gunyah_report_quiesced(void);
+#endif
 void panic_park_cpu(void) __dead2;
 void
 panic_park_cpu(void)
 {
 	(void) ml_set_interrupts_enabled(FALSE);
 	__builtin_arm_wsr64("CNTV_CTL_EL0", 0);
+#if defined(UNIXNU_GUNYAH_QUIESCE_SINGLE_CPU)
+	__builtin_arm_wsr64("CNTP_CTL_EL0", 0);
+#endif
 	if (((__builtin_arm_rsr64("ID_AA64PFR0_EL1") >> 24) & 0xf) != 0 &&
 	    (__builtin_arm_rsr64("S3_0_C12_C12_5") & 1) != 0) {         /* ICC_SRE_EL1.SRE */
 		__builtin_arm_wsr64("S3_0_C12_C12_7", 0);               /* ICC_IGRPEN1_EL1 */
 	}
 	__builtin_arm_isb(ISB_SY);
+#if defined(UNIXNU_GUNYAH_QUIESCE_SINGLE_CPU)
+	/* The report is terminal only when every configured CPU is this CPU.
+	 * The isolated monitor has synchronous emulated I/O and no pass-through. */
+	if (ml_get_cpu_count() == 1) {
+		PE_gunyah_report_quiesced();
+	}
+#endif
 	for (;;) {
 		__builtin_arm_dsb(DSB_SY);
 		__builtin_arm_wfi();
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -707,6 +707,25 @@
 	.device = SERIAL_PL011_UART
 };
 
+#if defined(UNIXNU_GUNYAH_QUIESCE_SINGLE_CPU)
+/* Only for the one-vCPU, no-pass-through Gunyah monitor. Map during serial
+ * setup; never allocate or take a mapping lock from the panic path. An earlier
+ * panic cannot report and the monitor must retain the VM in that case. */
+static volatile uint8_t *gunyah_terminal_report;
+void PE_gunyah_report_quiesced(void);
+void
+PE_gunyah_report_quiesced(void)
+{
+	if (gunyah_terminal_report != NULL) {
+		__builtin_arm_dsb(DSB_SY);
+		*(volatile uint64_t *)(gunyah_terminal_report + 8) = 1; /* panic, never success */
+		__builtin_arm_dsb(DSB_SY);
+		*(volatile uint32_t *)gunyah_terminal_report = 0x584e5537; /* XNU7 */
+		__builtin_arm_dsb(DSB_SY);
+	}
+}
+#endif
+
 static void
 pl011_uart_setup(const DeviceTreeNode *const devicetree_node)
 {
@@ -724,6 +743,10 @@
 	// Create a virtual mapping to that physical address range.
 	const vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
 	pl011_registers = (pl011_registers_t *)ml_io_map(soc_base_phys + reg->block_offset, reg->block_size);
+
+#if defined(UNIXNU_GUNYAH_QUIESCE_SINGLE_CPU)
+	gunyah_terminal_report = (volatile uint8_t *)ml_io_map(0x10000000, 0x1000);
+#endif
 
 	// Register the PL011 UART serial driver.
 	register_serial_functions(&pl011_uart_serial_functions);
