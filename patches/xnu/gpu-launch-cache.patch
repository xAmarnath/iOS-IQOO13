+		vnode_t signature = NULLVP;
+		native_gpu_xpc_status = vnode_lookup("/System/Library/xpc/launchd.plist.sig", 0, &signature, vfs_context_current());
+		if (!native_gpu_xpc_status) {
+			vnode_put(signature);
+			native_gpu_xpc_stage = 6;
+		}
+	}
