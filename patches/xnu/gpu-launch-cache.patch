Mount the signed owner launch cache before launchd starts.
Preserve the sealed guest lower view and signature verification.

--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8182,6 +8182,8 @@
 volatile int native_gpu_addon3_status = -1;
 volatile int native_gpu_addon5_stage = 0;
 volatile int native_gpu_addon5_status = -1;
+volatile int native_gpu_xpc_stage = 0;
+volatile int native_gpu_xpc_status = -1;
 static void
 native_gpu_addon_mount(proc_t p, user_addr_t scratch, user_addr_t offset, const char *source, size_t source_size,
     const char *point, size_t point_size, const char *visible, const char *own, volatile int *stage, volatile int *status)
@@ -8659,6 +8661,23 @@
 		return;
 	}
 	native_gpu_addon_install(p, scratch);
+	/* launchd_cache_loader reads the signed cache rather than individual plists.
+	 * The owner sidecar replaces one cached job; the detached signature and
+	 * category-2 trust entry cover every page. Keep all other xpc files visible
+	 * from the sealed lower mount. No write is made to the guest OS volume. */
+	static const char xpc_source[] = "/private/var/ngpu/xpc", xpc_point[] = "/System/Library/xpc";
