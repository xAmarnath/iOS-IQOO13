+
+/* BEGIN DROIDVM_DISPLAY_CALL_TRACE */
+static int
+droidvm_display_call_family(IOUserClient *client)
+{
+	if (!client) {
+		return -1;
+	}
+	const char *name = client->getMetaClass()->getClassName();
+	if (!name) {
+		return -1;
+	}
+	if (!strcmp(name, "IOSurfaceRootUserClient")) {
+		return 1;
+	}
+	return (!strncmp(name, "IOMobileFramebuffer", 19) || !strncmp(name, "IOMFB", 5)) ? 0 : -1;
+}
+
+static bool
+droidvm_display_call_selected(IOUserClient *client)
+{
+	unsigned enabled = 0;
+	PE_parse_boot_argn("droidvm-display-rpc", &enabled, sizeof(enabled));
+	if (enabled != 1 || !client) {
+		return false;
+	}
+	return droidvm_display_call_family(client) >= 0;
+}
+
+static unsigned
+droidvm_display_call_budget(IOUserClient *client, unsigned kind, uint32_t selector, bool failure)
+{
+	/* Two entry/return pairs and one later failure per selector. Unknown
+	 * selectors share one bucket. Separate IOSurface/IOMFB budgets avoid
+	 * one client's startup hiding the other. At most 1310 lines per boot. */
+	static unsigned calls[2][3][97], failures[2][3][97];
+	const int family = droidvm_display_call_family(client);
+	if (family < 0 || kind > 2) {
+		return 0;
+	}
+	const unsigned last = kind == 0 ? 96 : 16;
+	const unsigned slot = selector < last ? selector : last;
+	unsigned *value = failure ? &failures[family][kind][slot] : &calls[family][kind][slot];
+	unsigned seen = __atomic_load_n(value, __ATOMIC_RELAXED);
+	do {
+		if (seen >= (failure ? 1u : 2u)) {
+			return 0;
+		}
+	} while (!__atomic_compare_exchange_n(value, &seen, seen + 1, false,
+	    __ATOMIC_RELAXED, __ATOMIC_RELAXED));
+	return seen + 1;
+}
+
+static void
+droidvm_display_call_emit(IOUserClient *client, unsigned kind, uint32_t selector,
+    const IOExternalMethodArguments *args, unsigned ticket, const char *stage, IOReturn result)
+{
+	kprintf("droidvm-display-call: %s kind=%u class=%s pid=%d tid=%llu selector=%u n=%u "
+	    "result=0x%x scalars=%u/%u bytes=%u/%u descriptors=%u/%u\n",
+	    stage, kind, client->getMetaClass()->getClassName(), proc_selfpid(),
+	    (unsigned long long)thread_tid(current_thread()), selector, ticket, (unsigned)result,
+	    args ? args->scalarInputCount : 0, args ? args->scalarOutputCount : 0,
+	    args ? args->structureInputSize : 0, args ? args->structureOutputSize : 0,
+	    args && args->structureInputDescriptor ? 1u : 0u,
+	    args && args->structureOutputDescriptor ? 1u : 0u);
+}
+
+static unsigned
+droidvm_display_call_begin(IOUserClient *client, unsigned kind, uint32_t selector,
+    const IOExternalMethodArguments *args)
+{
+	if (!droidvm_display_call_selected(client)) {
+		return 0;
+	}
+	unsigned ticket = droidvm_display_call_budget(client, kind, selector, false);
+	if (ticket) {
+		droidvm_display_call_emit(client, kind, selector, args, ticket, "begin", 0);
+	}
+	return ticket;
+}
+
+static void
+droidvm_display_call_end(IOUserClient *client, unsigned kind, uint32_t selector,
+    const IOExternalMethodArguments *args, unsigned ticket, IOReturn result)
+{
+	if (ticket) {
+		droidvm_display_call_emit(client, kind, selector, args, ticket, "end", result);
+	} else if (result != kIOReturnSuccess && droidvm_display_call_selected(client)) {
+		ticket = droidvm_display_call_budget(client, kind, selector, true);
+		if (ticket) {
+			droidvm_display_call_emit(client, kind, selector, args, ticket, "failure", result);
+		}
+	}
+}
+/* END DROIDVM_DISPLAY_CALL_TRACE */
