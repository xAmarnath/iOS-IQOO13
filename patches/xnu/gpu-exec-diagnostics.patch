+/* Owner shader probe diagnostics only. Retain all native checks/results.
+ * copyinstr also covers failures before namei, without dereferencing user
+ * pointers or allocating memory. No filename or credentials are modified. */
+static void
+native_gpu_exec_trace(struct image_params *imgp, const char *stage, int status, int line)
+{
+	char path[128];
+	size_t copied = 0;
+	if (!imgp || !imgp->ip_user_fname || imgp->ip_seg == UIO_SYSSPACE) {
+		return;
+	}
+	if (copyinstr(imgp->ip_user_fname, path, sizeof(path), &copied) != 0 ||
+	    strcmp(path, "/private/var/ngpu/bin/adrenoprobed") != 0) {
+		return;
+	}
+	printf("droidvm-gpu-exec: pid %d stage %s line %d status %d flags 0x%x mac %d cs 0x%x\n",
+	    proc_getpid(current_proc()), stage, line, status, imgp->ip_flags,
+	    imgp->ip_mac_return, imgp->ip_csflags);
+}
