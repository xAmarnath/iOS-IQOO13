+			droidvm_display_rpc_trace("send", (uint32_t)(mv_id >> 32), 0,
+			    send_uctx.send_msg_size, (mach_port_name_t)mr_lp, option64,
+			    send_uctx.send_msg_addr);
+		}
 		mr = mach_msg_trap_send(&send_uctx, option64, msg_timeout, priority);
+		if (droidvm_display_rpc_id((uint32_t)(mv_id >> 32))) {
+			droidvm_display_rpc_trace("sent", (uint32_t)(mv_id >> 32), mr,
+			    send_uctx.send_msg_size, (mach_port_name_t)mr_lp, option64, 0);
+		}
