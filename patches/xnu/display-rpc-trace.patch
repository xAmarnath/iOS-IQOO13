--- a/osfmk/ipc/mach_msg.c
+++ b/osfmk/ipc/mach_msg.c
@@ -113,6 +113,63 @@
 
 #include <sys/kdebug.h>
 #include <sys/proc_ro.h>
+#include <pexpert/pexpert.h>
+#include <os/atomic_private.h>
+/* Match osfmk/kern/kmod.c and task.c: avoid BSD type collisions. */
+extern void proc_selfname(char *buf, int size);
+extern int proc_selfpid(void);
+
+
+/* Opt-in serial observation of the pinned QuartzCore display RPC. No policy changes. */
+static bool
+droidvm_display_rpc_id(uint32_t msgid)
+{
+	return msgid == 0x9d27 || msgid == 0x9d8b;
+}
+
+static void
+droidvm_display_rpc_trace(const char *event, uint32_t msgid,
+    mach_msg_return_t result, mach_msg_size_t size, mach_port_name_t port,
+    mach_msg_option64_t options, mach_vm_address_t user_message)
+{
+	static uint32_t rpc_count, error_count;
+	uint32_t *budget;
+	uint32_t count;
+	uint32_t words[9] = {0};
+	char name[32] = {0};
+	int enabled = 0, copied = -1, mig_valid = 0;
+	bool selected = droidvm_display_rpc_id(msgid);
+	if (!selected && result == MACH_MSG_SUCCESS) {
+		return;
+	}
+	PE_parse_boot_argn("droidvm-display-rpc", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	proc_selfname(name, sizeof(name));
+	if (!selected && strcmp(name, "chronod") && strcmp(name, "backboardd") &&
+	    strcmp(name, "SpringBoard")) {
+		return;
+	}
+	budget = selected ? &rpc_count : &error_count;
+	count = os_atomic_load(budget, relaxed);
+	do {
+		if (count >= (selected ? 128u : 64u)) {
+			return;
+		}
+	} while (!os_atomic_cmpxchgv(budget, count, count + 1, &count, relaxed));
+	/* MIG error replies have header + NDR + RetCode; complex replies differ. */
+	if (user_message && msgid == 0x9d8b && size >= sizeof(words)) {
+		copied = copyin(user_message, words, sizeof(words));
+		mig_valid = copied == 0 && !(words[0] & MACH_MSGH_BITS_COMPLEX) &&
+		    words[5] == msgid;
+	}
+	kprintf("droidvm-display-rpc: %s %s[%d] tid=%llu id=0x%x result=0x%x "
+	    "size=%u port=0x%x options=0x%llx copy=%d mig_valid=%d mig_rc=0x%x\n",
+	    event, name, proc_selfpid(), (unsigned long long)thread_tid(current_thread()),
+	    msgid, result, size, port, (unsigned long long)options, copied,
+	    mig_valid, mig_valid ? words[8] : 0);
+}
 
 #ifndef offsetof
 #define offsetof(type, member)  ((size_t)(&((type *)0)->member))
@@ -292,6 +349,8 @@
 	mach_msg_return_t       mr      = self->ith_state;
