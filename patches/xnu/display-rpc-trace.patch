 	ipc_kmsg_t              kmsg    = self->ith_kmsg;
+	uint32_t droidvm_rpc_id = mr == MACH_MSG_SUCCESS ?
+	    (uint32_t)ikm_header(kmsg)->msgh_id : 0;
 
 	mach_msg_recv_bufs_t recv_bufs = self->ith_recv_bufs;
 	mach_msg_recv_result_t msgr = {
@@ -378,6 +437,8 @@
