+      if (!bo->used || !bo->resource_id)
+         continue;
+      if (nr_bos == max_bos) {
+         os_log_error(OS_LOG_DEFAULT, "dwv: submit BO list exceeds wire capacity %u (IBs %u)",
+                      max_bos, req->buffer_count);
+         return kIOReturnNoResources;
+      }
+      ++nr_bos;
+   }
+   for (uint32_t i = 0; i < req->buffer_count; i++) {
+      const NativeAdrenoAbiSubmitBuffer *ib = &req->buffers[i];
+      const struct dwv_bo *bo = dwv_lookup(ib->handle);
