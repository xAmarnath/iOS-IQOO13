+/* All calls below hold dwv.lock. Keep every bound BO alive through native
+ * completion, including texture/data BOs that do not appear in the IB list. */
+static kern_return_t
+dwv_map_locked(struct dwv_bo *bo)
+{
+   if (!bo || !bo->kernel_handle)
+      return kIOReturnBadArgument;
+   if (bo->cpu_address)
+      return KERN_SUCCESS;
+   const struct droidvm_virtgpu_handle request = {bo->kernel_handle, 0};
+   struct droidvm_virtgpu_map_reply reply = {};
+   kern_return_t kr = vg_call(DROIDVM_VIRTGPU_MAP, &request, sizeof(request), &reply, sizeof(reply));
+   if (kr == KERN_SUCCESS) {
+      if (!reply.address || reply.size != bo->size || reply.address > UINT64_MAX - reply.size)
+         return kIOReturnUnderrun;
+      bo->cpu_address = (void *)(uintptr_t)reply.address;
+   }
+   return kr;
+}
+
+static kern_return_t
+dwv_cache_bos(void)
+{
+   for (uint32_t h = 1; h < dwv.bo_capacity; h++) {
+      struct dwv_bo *bo = &dwv.bos[h];
+      if (!bo->used || !bo->resource_id)
+         continue;
+      kern_return_t kr = dwv_map_locked(bo);
+      if (kr == KERN_SUCCESS)
+         kr = dwv_cache(bo->cpu_address, bo->size);
+      if (kr != KERN_SUCCESS)
+         return kr;
+   }
+   return KERN_SUCCESS;
+}
+
+static kern_return_t
+dwv_native_wait(uint64_t fence, uint64_t timeout_ns)
+{
+   if (!fence || fence > dwv.submit_fence || fence > INT32_MAX - 1u)
+      return kIOReturnBadArgument;
+   if (dwv.failed)
+      return kIOReturnError;
+   if (fence <= dwv.completed_fence)
+      return KERN_SUCCESS;
+   const uint64_t start = os_time_get_nano();
+   for (;;) {
+      struct { uint32_t header[4], queue, fence; } request =
+         {{DWV_CCMD_WAIT_FENCE, 0, 0, 0}, dwv.queue_id, (uint32_t)fence};
+      kern_return_t kr = vg_ccmd(&request, sizeof(request), 8);
+      if (kr != KERN_SUCCESS)
+         return kr;
+      int32_t status;
+      memcpy(&status, (const void *)(vg_response() + 4), sizeof(status));
+      if (!status) {
+         dwv.completed_fence = (uint32_t)fence;
+         kr = dwv_cache_bos();
+         if (kr != KERN_SUCCESS)
+            dwv.failed = true;
+         return kr;
+      }
+      /* These are Linux wire errno values, not Darwin errno numbers. */
+      if (status != -110 && status != -35) {
+         os_log_error(OS_LOG_DEFAULT, "dwv: native fence %llu failed: %d", (unsigned long long)fence, status);
+         dwv.failed = true;
+         return kIOReturnError;
+      }
+      if (!timeout_ns || (uint64_t)os_time_get_nano() - start >= timeout_ns)
+         return kIOReturnTimeout;
+      usleep(50);
+   }
+}
