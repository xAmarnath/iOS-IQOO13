+/* The shared transport maps whole 16KiB pages even when Vulkan asks for
+ * fewer bytes. Reserve and release that same extent, including lazy VMAs.
+ * CPU page size alone is not the shared GPU mapping alignment. */
+static uint64_t
+darwin_iova_size(uint64_t size)
+{
+   if (!dwv_gunyah_shared())
+      return size;
+   return size && size <= UINT64_MAX - 16383 ? (size + 16383) & ~16383ull : 0;
+}
+
+static uint64_t
+darwin_iova_alignment(void)
+{
+   return dwv_gunyah_shared() && os_page_size < 16384 ? 16384 : os_page_size;
+}
