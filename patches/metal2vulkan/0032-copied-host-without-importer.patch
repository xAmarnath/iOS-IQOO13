+                crate::CpuCacheMode::DefaultCache,
+                crate::HazardTrackingMode::Default,
+            ),
+            None,
+        )
+    }
+    .unwrap();
+    assert!(first.copied() && second.copied());
+    assert_eq!(moved(&before, &device.work_counts()), [0, 1, 0, 1, 0]);
+    assert!(Arc::ptr_eq(
+        first.host_pages().unwrap().import(),
+        second.host_pages().unwrap().import()
+    ));
+    let output = device
+        .new_buffer(LENGTH as u64, ResourceOptions::shared())
+        .unwrap();
+    blit(&device, |encoder| {
+        encoder.fill_buffer(&first, 0..LENGTH as u64, 0xA7).unwrap();
+        encoder
+            .copy_from_buffer_to_buffer(&second, 0, &output, 0, LENGTH as u64)
+            .unwrap();
+    });
+    // SAFETY: output is mapped and the real Vulkan command has completed.
+    let bytes = unsafe { std::slice::from_raw_parts(output.contents().unwrap().as_ptr(), LENGTH) };
+    assert!(
+        bytes.iter().all(|&b| b == 0xA7),
+        "same-command alias read sees the GPU write"
+    );
+    drop(first);
+    host.write(0, &[0x42; LENGTH]);
+    assert_eq!(gpu_bytes(&device, &second), vec![0x42; LENGTH]);
+    blit(&device, |encoder| {
+        encoder
+            .fill_buffer(&second, 0..LENGTH as u64, 0x19)
+            .unwrap()
+    });
+    assert_eq!(host.bytes(), vec![0x19; LENGTH]);
+}
+
+#[test]
+fn copied_without_import_extension_rejects_overlapping_independent_copies() {
+    let host = Host::new(23);
+    let (device, _heard) = device_with_import(false).unwrap();
+    let first = host.buffer(&device, None);
+    // SAFETY: this subset lies in the allocation, retained through the call.
+    let partial = unsafe {
+        device.new_buffer_with_bytes_no_copy(
+            HostMemory::new(NonNull::new(host.pointer.as_ptr().add(4096)).unwrap()),
+            (LENGTH - 4096) as u64,
+            ResourceOptions::shared(),
+            None,
+        )
+    };
+    assert!(
+        partial.is_err(),
+        "overlap must not create incoherent backing"
+    );
+    assert_eq!(device.work_counts().copied_host_buffers_made, 1);
+    drop(first);
+}
+
+#[test]
+fn copied_without_import_extension_heap_writes_reach_host() {
+    let host = Host::new(24);
+    let (device, _heard) = device_with_import(false).unwrap();
+    let copied = heap(&device, &host, None);
+    let buffer = copied
+        .new_buffer_at_offset(4096, ResourceOptions::shared(), 16384)
+        .unwrap();
+    assert_eq!(device.work_counts().copied_heaps_made, 1);
+    blit(&device, |encoder| {
+        encoder.fill_buffer(&buffer, 0..4096, 0x74).unwrap()
+    });
+    let bytes = host.bytes();
+    assert_eq!(&bytes[16384..20480], &[0x74; 4096]);
+    assert_eq!(&bytes[..16384], &host.pattern()[..16384]);
+    assert_eq!(&bytes[20480..], &host.pattern()[20480..]);
+}
+
+#[test]
+fn copied_without_import_extension_keeps_unsupported_options_and_heap_alignment_errors() {
+    let host = Host::new(25);
+    let (device, _heard) = device_with_import(false).unwrap();
+    for options in [
+        ResourceOptions::private(),
+        ResourceOptions::from_raw(ResourceOptions::PRIVATE_BIT).unwrap(),
+    ] {
+        // SAFETY: the host outlives the call, which must refuse these storage contracts.
+        let result = unsafe {
+            device.new_buffer_with_bytes_no_copy(
+                HostMemory::new(host.pointer),
+                LENGTH as u64,
+                options,
+                None,
+            )
+        };
+        assert!(
+            result.is_err(),
+            "unsupported mode must not silently become a writable copy"
+        );
+    }
+    let descriptor =
+        crate::HeapDescriptor::new(crate::HeapType::Placement, 4096, ResourceOptions::shared());
+    // SAFETY: these bytes lie inside the retained allocation; the unaligned heap is refused.
+    let result = unsafe {
+        device.new_heap_with_bytes_no_copy(
+            HostMemory::new(NonNull::new(host.pointer.as_ptr().add(1)).unwrap()),
+            &descriptor,
+            None,
+            None,
+        )
+    };
+    assert!(result.is_err());
+    assert_eq!(device.work_counts().copied_host_buffers_made, 0);
+}
+
+#[test]
+fn copied_without_import_extension_concurrent_aliases_share_one_allocation() {
+    let host = Host::new(26);
+    let (device, _heard) = device_with_import(false).unwrap();
+    let pointer = host.pointer.as_ptr() as usize;
+    let barrier = std::sync::Barrier::new(8);
+    let buffers = std::thread::scope(|scope| {
+        let jobs: Vec<_> = (0..8)
+            .map(|_| {
+                let device = &device;
+                let barrier = &barrier;
+                scope.spawn(move || {
+                    barrier.wait();
+                    // SAFETY: host remains allocated until all joined workers and buffers are gone;
+                    // the constructors only read its pages, and no GPU work is submitted concurrently.
+                    unsafe {
+                        device.new_buffer_with_bytes_no_copy(
+                            HostMemory::new(NonNull::new(pointer as *mut u8).unwrap()),
+                            LENGTH as u64,
+                            ResourceOptions::shared(),
+                            None,
+                        )
+                    }
+                    .unwrap()
+                })
+            })
+            .collect();
+        jobs.into_iter()
+            .map(|job| job.join().unwrap())
+            .collect::<Vec<_>>()
+    });
+    assert_eq!(device.work_counts().copied_host_buffers_made, 1);
+    for buffer in &buffers[1..] {
+        assert!(Arc::ptr_eq(
+            buffers[0].host_pages().unwrap().import(),
+            buffer.host_pages().unwrap().import()
+        ));
+    }
+    blit(&device, |encoder| {
+        encoder
+            .fill_buffer(&buffers[3], 0..LENGTH as u64, 0x68)
+            .unwrap()
+    });
+    assert_eq!(gpu_bytes(&device, &buffers[7]), vec![0x68; LENGTH]);
+    assert_eq!(host.bytes(), vec![0x68; LENGTH]);
+}
