diff --git a/crates/metal2vulkan-runtime/src/tests/scratch_spares.rs b/crates/metal2vulkan-runtime/src/tests/scratch_spares.rs
new file mode 100644
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/scratch_spares.rs
@@ -0,0 +1,145 @@
+//! Actual Vulkan buffers: bound idle caches across shadows; preserve borrowed buffers.
+use super::{ScratchSpares, SpareRegistry};
+use crate::{Buffer, Device, DeviceKind, DeviceOptions, HazardTrackingMode};
+use std::sync::{Arc, Mutex};
+
+fn device() -> Device {
+    Device::system_default_with(&DeviceOptions {
+        kinds: if cfg!(m2v_cpu_icd) {
+            vec![DeviceKind::Cpu]
+        } else {
+            vec![
+                DeviceKind::Discrete,
+                DeviceKind::Integrated,
+                DeviceKind::Virtual,
+            ]
+        },
+        ..DeviceOptions::default()
+    })
+    .unwrap()
+}
+
+fn cache(registry: &SpareRegistry) -> ScratchSpares {
+    let cache = ScratchSpares(Arc::new(Mutex::new(Vec::new())));
+    registry.lock().unwrap().push(Arc::downgrade(&cache.0));
+    cache
+}
+
+fn buffer(device: &Device, bytes: u64) -> Buffer {
+    device
+        .unzeroed_buffer(bytes, HazardTrackingMode::Default)
+        .unwrap()
+}
+
+fn bytes(registry: &SpareRegistry) -> u64 {
+    registry
+        .lock()
+        .unwrap()
+        .iter()
+        .filter_map(|weak| weak.upgrade())
+        .map(|cache| {
+            cache
+                .lock()
+                .unwrap()
+                .iter()
+                .map(|(b, _)| b.length())
+                .sum::<u64>()
+        })
+        .sum()
+}
+
+#[test]
+fn process_budget_reclaims_oldest_across_shadows() {
+    let device = device();
+    let registry = Mutex::new(Vec::new());
+    let a = cache(&registry);
+    let b = cache(&registry);
+    let c = cache(&registry);
+    const ONE: u64 = 1 << 20;
+    for spare in [&a, &b, &c] {
+        spare.give_limited(buffer(&device, ONE), Some(2 * ONE), &registry);
+    }
+    assert_eq!(bytes(&registry), 2 * ONE, "one budget across all shadows");
+    assert!(a.take(1).is_none(), "oldest completed scratch reclaimed");
+    assert!(b.take(ONE).is_some());
+    assert!(c.take(ONE).is_some());
+}
+
+#[test]
+fn oversized_and_disabled_caches_keep_no_idle_allocation() {
+    let device = device();
+    let registry = Mutex::new(Vec::new());
+    let spare = cache(&registry);
+    spare.give_limited(buffer(&device, 4 << 20), Some(1 << 20), &registry);
+    assert_eq!(bytes(&registry), 0);
+    spare.give_limited(buffer(&device, 4096), Some(0), &registry);
+    assert_eq!(bytes(&registry), 0);
+}
+
+#[test]
+fn borrowed_scratch_survives_eviction_and_remains_usable_by_commands() {
+    let device = device();
+    let registry = Mutex::new(Vec::new());
+    let a = cache(&registry);
+    let b = cache(&registry);
+    const N: u64 = 1 << 20;
+    a.give_limited(buffer(&device, N), Some(N), &registry);
+    let borrowed = a.take(N).unwrap();
+    // While a merge owns it, it is absent from every idle cache.
+    a.give_limited(buffer(&device, N), Some(N), &registry);
+    b.give_limited(buffer(&device, N), Some(N), &registry);
+    assert_eq!(bytes(&registry), N);
+    assert!(a.take(1).is_none());
+    assert_eq!(borrowed.length(), N);
+    let queue = device.new_command_queue().unwrap();
+    let command = queue.command_buffer().unwrap();
+    let mut encoder = command.blit_command_encoder().unwrap();
+    encoder.fill_buffer(&borrowed, 0..N, 0x5a).unwrap();
+    encoder.end_encoding().unwrap();
+    command.commit().unwrap();
+    command
+        .wait_until_completed_for(std::time::Duration::from_secs(30))
+        .unwrap();
+    assert_eq!(command.status(), crate::CommandBufferStatus::Completed);
+}
+
+#[test]
+fn ordinary_backend_keeps_two_and_takes_smallest_fit() {
+    let device = device();
+    let registry = Mutex::new(Vec::new());
+    let spare = cache(&registry);
+    for size in [4096, 8192, 16384] {
+        spare.give_limited(buffer(&device, size), None, &registry);
+    }
+    assert_eq!(bytes(&registry), 8192 + 16384);
+    assert_eq!(spare.take(4096).unwrap().length(), 8192);
+    assert_eq!(spare.take(10000).unwrap().length(), 16384);
+    assert!(spare.take(1).is_none());
+}
+
+#[test]
+fn concurrent_returns_and_dead_shadows_remain_bounded() {
+    let device = device();
+    let registry = Mutex::new(Vec::new());
+    drop(cache(&registry));
+    let a = cache(&registry);
+    let b = cache(&registry);
+    std::thread::scope(|scope| {
+        for spare in [&a, &b] {
+            let device = &device;
+            let registry = &registry;
+            scope.spawn(move || {
+                for _ in 0..8 {
+                    spare.give_limited(buffer(device, 1 << 20), Some(2 << 20), registry);
+                    assert!(bytes(registry) <= 2 << 20);
+                }
+            });
+        }
+    });
+    assert_eq!(
+        registry.lock().unwrap().len(),
+        2,
+        "dead registry entries removed"
+    );
+    assert_eq!(bytes(&registry), 2 << 20);
+}
