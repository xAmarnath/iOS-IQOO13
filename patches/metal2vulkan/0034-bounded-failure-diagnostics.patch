new file mode 100644
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/failure_trace.rs
@@ -0,0 +1,120 @@
+//! Bounded failure evidence, independent of optional tracing and heap allocation.
+use std::fmt::{self, Write};
+use std::sync::Mutex;
+
+const CAPACITY: usize = 16;
+const LINE_BYTES: usize = 512;
+
+struct Line {
+    bytes: [u8; LINE_BYTES],
+    len: usize,
+}
+
+impl Write for Line {
+    fn write_str(&mut self, text: &str) -> fmt::Result {
+        let mut count = text.len().min(LINE_BYTES - 1 - self.len);
+        while !text.is_char_boundary(count) {
+            count -= 1;
+        }
+        self.bytes[self.len..self.len + count].copy_from_slice(&text.as_bytes()[..count]);
+        self.len += count;
+        Ok(())
+    }
+}
+
+struct Trace {
+    lines: [Line; CAPACITY],
+    next: usize,
+    count: usize,
+}
+
+impl Trace {
+    const fn new() -> Self {
+        Self {
+            lines: [const {
+                Line {
+                    bytes: [0; LINE_BYTES],
+                    len: 0,
+                }
+            }; CAPACITY],
+            next: 0,
+            count: 0,
+        }
+    }
+
+    fn push(&mut self, text: fmt::Arguments<'_>) {
+        let line = &mut self.lines[self.next];
+        line.len = 0;
+        let _ = line.write_fmt(text);
+        for byte in &mut line.bytes[..line.len] {
+            if *byte == 0 {
+                *byte = b'?';
+            }
+        }
+        self.next = (self.next + 1) % CAPACITY;
+        self.count = (self.count + 1).min(CAPACITY);
+    }
+
+    fn read(&mut self, out: &mut [u8]) -> usize {
+        if self.count == 0 {
+            return 0;
+        }
+        let line = &self.lines[(self.next + CAPACITY - self.count) % CAPACITY];
+        if out.len() <= line.len {
+            return 0;
+        }
+        out[..line.len].copy_from_slice(&line.bytes[..line.len]);
+        out[line.len] = 0;
+        self.count -= 1;
+        line.len
+    }
+}
+
+static TRACE: Mutex<Trace> = Mutex::new(Trace::new());
+
+/// Record a failure and its caller, keeping the last sixteen records without heap allocation.
+#[track_caller]
+pub(crate) fn record(text: fmt::Arguments<'_>) {
+    if let Ok(mut trace) = TRACE.lock() {
+        trace.push(format_args!("{}: {text}", std::panic::Location::caller()));
+    }
+}
+
+/// Consume the oldest note into `out`, terminated by NUL. Zero leaves it queued if `out` is too short.
+pub fn read(out: &mut [u8]) -> usize {
+    TRACE.lock().map_or(0, |mut trace| trace.read(out))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bounded_history_keeps_order_and_does_not_consume_short_reads() {
+        let mut trace = Trace::new();
+        for i in 0..CAPACITY + 3 {
+            trace.push(format_args!("failure {i}"));
+        }
+        let mut short = [9u8; 2];
+        assert_eq!(trace.read(&mut short), 0);
+        assert_eq!(short, [9, 9]);
+        let mut out = [0u8; LINE_BYTES];
+        for i in 3..CAPACITY + 3 {
+            let n = trace.read(&mut out);
+            assert_eq!(&out[..n], format!("failure {i}").as_bytes());
+            assert_eq!(out[n], 0);
+        }
+        assert_eq!(trace.read(&mut out), 0);
+    }
+
+    #[test]
+    fn truncation_keeps_utf8_and_removes_embedded_nuls() {
+        let mut trace = Trace::new();
+        trace.push(format_args!("a\0{}", "界".repeat(600)));
+        let mut out = [0u8; LINE_BYTES];
+        let n = trace.read(&mut out);
+        assert!(std::str::from_utf8(&out[..n]).unwrap().starts_with("a?界"));
+        assert!(n < LINE_BYTES);
+        assert_eq!(out[n], 0);
+    }
+}
