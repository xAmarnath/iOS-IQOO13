diff --git a/crates/metal2vulkan-runtime/src/tests/copied_device.rs b/crates/metal2vulkan-runtime/src/tests/copied_device.rs
--- a/crates/metal2vulkan-runtime/src/tests/copied_device.rs
+++ b/crates/metal2vulkan-runtime/src/tests/copied_device.rs
@@ -922,3 +922,61 @@
     assert_eq!(gpu_bytes(&device, &buffers[7]), vec![0x68; LENGTH]);
     assert_eq!(host.bytes(), vec![0x68; LENGTH]);
 }
+
+// Register copied pages and signal a real Vulkan timeline independently of the completion
+// service. This deterministically models a GPU signal read before the completion turn; no
+// completion thread can perform the merge for the reader. Existing blit tests cover GPU writes.
+#[test]
+fn copied_event_read_publishes_pages_before_a_completion_turn() {
+    copied_event_observation(false);
+}
+
+#[test]
+fn copied_event_host_set_preserves_cpu_pages_without_a_gpu_signal() {
+    copied_event_observation(true);
+}
+
+fn copied_event_observation(host_set: bool) {
+    use ash::vk;
+    let host = Host::new(31);
+    let backing = Host::new(32);
+    let (device, _heard) = device_with_import(false).unwrap();
+    // SAFETY: both allocations outlive registration, and no GPU command accesses them.
+    let _copy = unsafe {
+        device
+            .shared()
+            .copied
+            .add(host.pointer, backing.pointer, LENGTH)
+    }
+    .unwrap();
+    backing.write(0, &[0xA6; LENGTH]);
+    let event = device.new_shared_event().unwrap();
+    if host_set {
+        event.set_signaled_value(7);
+        assert_eq!(event.signaled_value(), 7);
+        assert_eq!(
+            host.bytes(),
+            host.pattern(),
+            "host-set values are not GPU completion"
+        );
+        return;
+    }
+    let shared = crate::EventRef::from(&event).shared().clone();
+    shared.keep(1, 7, 0);
+    let signal = vk::SemaphoreSignalInfo::default()
+        .semaphore(shared.semaphore())
+        .value(1);
+    // SAFETY: the live device owns the semaphore; no queue submits to this isolated event.
+    unsafe { device.shared().vk().signal_semaphore(&signal) }.unwrap();
+    assert_eq!(
+        host.bytes(),
+        host.pattern(),
+        "copied pages have not been merged yet"
+    );
+    assert_eq!(event.signaled_value(), 7);
+    assert_eq!(
+        host.bytes(),
+        vec![0xA6; LENGTH],
+        "observing the event must publish copied writes"
+    );
+}
