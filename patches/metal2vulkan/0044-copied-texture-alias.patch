+#[test]
+#[cfg(target_os = "linux")]
+fn copied_texture_alias_readonly_preserves_completion_failure() {
+    let host = Host::new(56);
+    let (device, _) = device_with_import(false).unwrap();
+    let buffer = host.buffer(&device, None);
+    let texture = copied_alias_texture(&buffer);
+    assert!(texture.aliases_buffer());
+    device.shared().copied.set_read_only_for_test(host.pointer);
+    assert_eq!(
+        copied_alias_read(&device, &texture),
+        host.pattern()[4096..8192]
+    );
+    let input = device
+        .new_buffer_with_bytes(&[0xC3; 4096], ResourceOptions::shared())
+        .unwrap();
+    let queue = device.new_command_queue().unwrap();
+    let cb = queue.command_buffer().unwrap();
+    let mut encoder = cb.blit_command_encoder().unwrap();
+    copied_alias_write(&mut encoder, &input, &texture);
+    encoder.end_encoding().unwrap();
+    cb.commit().unwrap();
+    cb.wait_until_completed_for(WAIT).unwrap();
+    assert_eq!(cb.status(), CommandBufferStatus::Error);
+    assert_eq!(
+        cb.error(),
+        Some(crate::CommandBufferError::Internal(crate::VkResultCode(
+            ash::vk::Result::ERROR_VALIDATION_FAILED_EXT.as_raw()
+        )))
+    );
+    assert_eq!(host.bytes(), host.pattern());
+}
