+fn copied_alias_texture(buffer: &Buffer) -> crate::Texture {
+    let mut descriptor = crate::TextureDescriptor::texture_2d(
+        metal2vulkan::metal::PixelFormat::RGBA8Unorm,
+        64,
+        16,
+        false,
+    );
+    descriptor.usage = metal2vulkan::metal::TextureUsage::SHADER_READ
+        | metal2vulkan::metal::TextureUsage::SHADER_WRITE;
+    buffer.new_texture(&descriptor, 4096, 256).unwrap()
+}
+
+fn copied_alias_read(device: &Device, texture: &crate::Texture) -> Vec<u8> {
+    let output = device.new_buffer(4096, ResourceOptions::shared()).unwrap();
+    blit(device, |encoder| {
+        encoder
+            .copy_from_texture_to_buffer(
+                texture,
+                0,
+                0,
+                crate::Origin { x: 0, y: 0, z: 0 },
+                crate::Size::new(64, 16, 1),
+                &output,
+                0,
+                256,
+                4096,
+                crate::BlitOption::None,
+            )
+            .unwrap();
+    });
+    // SAFETY: the completed GPU copy initialized these live mapped bytes.
+    unsafe { std::slice::from_raw_parts(output.contents().unwrap().as_ptr(), 4096) }.to_vec()
+}
+
+fn copied_alias_write(
+    encoder: &mut crate::BlitCommandEncoder,
+    input: &Buffer,
+    texture: &crate::Texture,
+) {
+    encoder
+        .copy_from_buffer_to_texture(
+            input,
+            0,
+            256,
+            4096,
+            crate::Size::new(64, 16, 1),
+            texture,
+            0,
+            0,
+            crate::Origin { x: 0, y: 0, z: 0 },
+            crate::BlitOption::None,
+        )
+        .unwrap();
+}
+
+#[test]
+fn copied_texture_alias_coherence_and_buffer_lifetime_without_import() {
+    let host = Host::new(50);
+    let (device, _) = device_with_import(false).unwrap();
+    let buffer = host.buffer(&device, None);
+    let texture = copied_alias_texture(&buffer);
+    assert!(
+        texture.aliases_buffer(),
+        "texture must reuse the GPU buffer allocation"
+    );
+    assert_eq!(
+        copied_alias_read(&device, &texture),
+        host.pattern()[4096..8192]
+    );
+    host.write(4113, &[0xA9; 37]);
+    assert_eq!(
+        copied_alias_read(&device, &texture),
+        host.bytes()[4096..8192]
+    );
+    drop(buffer);
+    let input = device
+        .new_buffer_with_bytes(&[0xC3; 4096], ResourceOptions::shared())
+        .unwrap();
+    blit(&device, |encoder| {
+        copied_alias_write(encoder, &input, &texture)
+    });
+    let mut expected = host.pattern();
+    expected[4096..8192].fill(0xC3);
+    assert_eq!(host.bytes(), expected, "only texture texels are written");
+    assert_eq!(copied_alias_read(&device, &texture), vec![0xC3; 4096]);
+}
+
+#[test]
+fn copied_texture_alias_rebind_import_and_detach() {
+    let first = Host::new(51);
+    let second = Host::new(52);
+    let third = Host::new(53);
+    let (device, _) = device().expect("host import required for rebind regression");
+    let asked = Arc::default();
+    let buffer = first.buffer(&device, Some(gate(&asked, false)));
+    let texture = copied_alias_texture(&buffer);
+    assert!(texture.aliases_buffer());
+    assert_eq!(
+        copied_alias_read(&device, &texture),
+        first.pattern()[4096..8192]
+    );
+    rebind(&buffer, &second, Some(gate(&asked, false))).unwrap();
+    assert!(buffer.copied());
+    assert_eq!(
+        copied_alias_read(&device, &texture),
+        second.pattern()[4096..8192]
+    );
+    rebind(&buffer, &third, None).unwrap();
+    assert!(!buffer.copied());
+    assert_eq!(
+        copied_alias_read(&device, &texture),
+        third.pattern()[4096..8192]
+    );
+    rebind(&buffer, &second, Some(gate(&asked, false))).unwrap();
+    buffer.detach_backing().unwrap();
+    rebind(&buffer, &first, Some(gate(&asked, false))).unwrap();
+    assert_eq!(
+        copied_alias_read(&device, &texture),
+        first.pattern()[4096..8192]
+    );
+    assert_eq!(second.bytes(), second.pattern());
+    assert_eq!(third.bytes(), third.pattern());
+}
