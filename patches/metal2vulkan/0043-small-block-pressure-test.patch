diff --git a/crates/metal2vulkan-runtime/src/tests/allocation_pressure.rs b/crates/metal2vulkan-runtime/src/tests/allocation_pressure.rs
--- a/crates/metal2vulkan-runtime/src/tests/allocation_pressure.rs
+++ b/crates/metal2vulkan-runtime/src/tests/allocation_pressure.rs
@@ -229,3 +229,88 @@
     assert_eq!(resident(&device), before);
     assert_eq!(device.work_counts().object_churn.buffers_evicted, 0);
 }
+
+// Separate processes keep allocator policy and Vulkan initialization isolated.
+#[test]
+fn small_blocks_preserve_mixed_live_resources_under_pressure() {
+    const CHILD: &str = "M2V_BLOCK_PRESSURE_CHILD";
+    let Ok(policy) = std::env::var(CHILD) else {
+        for mib in ["32", "4"] {
+            let status = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "tests::allocation_pressure::small_blocks_preserve_mixed_live_resources_under_pressure",
+                    "--nocapture"])
+                .env(CHILD, mib)
+                .env("METAL2VULKAN_BLOCK_MIB", mib)
+                .env("METAL2VULKAN_KEEP_ROOM_MIB", "0")
+                .status().unwrap();
+            assert!(status.success(), "{mib} MiB policy child failed");
+        }
+        return;
+    };
+    let device = device();
+    let queue = device.new_command_queue().unwrap();
+    let output = device.new_buffer(4096, ResourceOptions::shared()).unwrap();
+    let baseline = resident(&device);
+    let limit = Limit::new(&device, baseline + (76 << 20), None);
+    let mut buffers = Vec::new();
+    let mut images = Vec::new();
+    let mut exhausted = false;
+    for _ in 0..5 {
+        match device.unzeroed_buffer(12 << 20, HazardTrackingMode::Default) {
+            Ok(buffer) => buffers.push(buffer),
+            Err(Error::OutOfMemory(_)) => {
+                exhausted = true;
+                break;
+            }
+            Err(error) => panic!("unexpected allocation error: {error:?}"),
+        }
+    }
+    if !exhausted {
+        for _ in 0..3 {
+            match device.new_texture(&descriptor(1024, 768)) {
+                Ok(image) => images.push(image),
+                Err(Error::OutOfMemory(_)) => {
+                    exhausted = true;
+                    break;
+                }
+                Err(error) => panic!("unexpected image error: {error:?}"),
+            }
+        }
+    }
+    println!(
+        "BLOCK_POLICY_MIB={policy} buffers={} images={} resident_delta={} refused={}",
+        buffers.len(),
+        images.len(),
+        resident(&device) - baseline,
+        limit.counts().1
+    );
+    assert_eq!(
+        exhausted,
+        policy == "32",
+        "reproduce pool slack and fit the smaller policy"
+    );
+    if policy == "4" {
+        assert_eq!((buffers.len(), images.len()), (5, 3));
+    }
+    // Genuine exhaustion must still fail without discarding the earlier resources.
+    assert!(matches!(
+        device.unzeroed_buffer(80 << 20, HazardTrackingMode::Default),
+        Err(Error::OutOfMemory(_))
+    ));
+    let command = queue.command_buffer().unwrap();
+    let mut blit = command.blit_command_encoder().unwrap();
+    blit.fill_buffer(&buffers[0], 0..4096, 0x6d).unwrap();
+    blit.copy_from_buffer_to_buffer(&buffers[0], 0, &output, 0, 4096)
+        .unwrap();
+    blit.end_encoding().unwrap();
+    command.commit().unwrap();
+    command
+        .wait_until_completed_for(Duration::from_secs(30))
+        .unwrap();
+    assert_eq!(command.status(), CommandBufferStatus::Completed);
+    // SAFETY: the GPU copy completed and output remains live.
+    let bytes = unsafe { std::slice::from_raw_parts(output.contents().unwrap().as_ptr(), 4096) };
+    assert!(bytes.iter().all(|&byte| byte == 0x6d));
+    drop(limit);
+    drop((images, buffers));
+}
