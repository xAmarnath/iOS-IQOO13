+#[test]
+#[cfg(target_os = "linux")]
+fn copied_readonly_input_is_read_by_real_gpu_work() {
+    let host = Host::new(41);
+    let (device, _heard) = device_with_import(false).unwrap();
+    let buffer = host.buffer(&device, None);
+    device.shared().copied.set_read_only_for_test(host.pointer);
+    assert_eq!(gpu_bytes(&device, &buffer), host.pattern());
+    // Models updates made through another writable mapping of the retained VM object.
+    host.write(17, &[0xA8; 37]);
+    assert_eq!(gpu_bytes(&device, &buffer), host.bytes());
+}
+
+#[test]
+#[cfg(target_os = "linux")]
+fn copied_readonly_real_gpu_write_fails_completion_without_publishing_pages() {
+    let host = Host::new(42);
+    let (device, _heard) = device_with_import(false).unwrap();
+    let buffer = host.buffer(&device, None);
+    device.shared().copied.set_read_only_for_test(host.pointer);
+    let queue = device.new_command_queue().unwrap();
+    let cb = queue.command_buffer().unwrap();
+    let mut encoder = cb.blit_command_encoder().unwrap();
+    encoder
+        .fill_buffer(&buffer, 0..LENGTH as u64, 0x55)
+        .unwrap();
+    encoder.end_encoding().unwrap();
+    cb.commit().unwrap();
+    let expected = crate::CommandBufferError::Internal(crate::VkResultCode(
+        ash::vk::Result::ERROR_VALIDATION_FAILED_EXT.as_raw(),
+    ));
+    cb.wait_until_completed_for(WAIT).unwrap();
+    assert_eq!(cb.error(), Some(expected));
+    assert_eq!(cb.status(), CommandBufferStatus::Error);
+    assert_eq!(host.bytes(), host.pattern());
+}
