+#[test]
+#[cfg(target_os = "linux")]
+fn copied_readonly_event_read_never_publishes_a_failed_merge() {
+    use ash::vk;
+    let host = Host::new(43);
+    let backing = Host::new(44);
+    let (device, _heard) = device_with_import(false).unwrap();
+    // SAFETY: buffers outlive registration; this test uses an isolated real Vulkan semaphore.
+    let copy = unsafe {
+        device
+            .shared()
+            .copied
+            .add(host.pointer, backing.pointer, LENGTH)
+    }
+    .unwrap();
+    device.shared().copied.set_read_only_for_test(host.pointer);
+    backing.write(0, &[0xBB; LENGTH]);
+    let event = device.new_shared_event().unwrap();
+    let shared = crate::EventRef::from(&event).shared().clone();
+    shared.keep(1, 7, 0);
+    let signal = vk::SemaphoreSignalInfo::default()
+        .semaphore(shared.semaphore())
+        .value(1);
+    // SAFETY: live device owns this semaphore; no queue uses it.
+    unsafe { device.shared().vk().signal_semaphore(&signal) }.unwrap();
+    assert_eq!(event.signaled_value(), 0);
+    assert_eq!(
+        event.signaled_value(),
+        0,
+        "another observer must not hide the error"
+    );
+    assert_eq!(host.bytes(), host.pattern());
+    assert!(
+        device
+            .shared()
+            .copied
+            .copy_in(&device.shared().counts)
+            .is_err()
+    );
+    drop(copy);
+}
