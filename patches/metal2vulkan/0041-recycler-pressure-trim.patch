diff --git a/crates/metal2vulkan-runtime/src/tests/recycle_pressure.rs b/crates/metal2vulkan-runtime/src/tests/recycle_pressure.rs
new file mode 100644
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/recycle_pressure.rs
@@ -0,0 +1,155 @@
+//! Pressure trimming must release completed resources, never command-owned ones.
+use crate::{
+    CommandBufferStatus, Device, DeviceKind, DeviceOptions, HazardTrackingMode, ResourceOptions,
+    TextureDescriptor,
+};
+use metal2vulkan::metal::{PixelFormat, TextureUsage};
+use std::time::Duration;
+
+// Device enumeration can share the underlying device. Keep physical allocation and
+// churn assertions isolated from the other pressure tests, including failed baselines.
+static TEST_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+fn device() -> Device {
+    Device::system_default_with(&DeviceOptions {
+        kinds: if cfg!(m2v_cpu_icd) {
+            vec![DeviceKind::Cpu]
+        } else {
+            vec![
+                DeviceKind::Discrete,
+                DeviceKind::Integrated,
+                DeviceKind::Virtual,
+            ]
+        },
+        ..DeviceOptions::default()
+    })
+    .unwrap()
+}
+
+fn resident_blocks(device: &Device) -> u64 {
+    // allocated() is lifetime allocation traffic, including blocks freed since.
+    // Count the currently retained blocks, including empty caches and imports.
+    let census = device.shared().memory.lock().unwrap().census();
+    census.pooled_bytes + census.empty_bytes + census.dedicated_bytes + census.imported_bytes
+}
+
+#[test]
+fn pressure_releases_parked_buffer_and_its_newly_empty_block() {
+    let _serial = TEST_LOCK
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let device = device();
+    device.trim_kept_memory(Duration::ZERO);
+    let baseline = resident_blocks(&device);
+    let buffer = device
+        .unzeroed_buffer(1 << 20, HazardTrackingMode::Default)
+        .unwrap();
+    let full = resident_blocks(&device);
+    assert!(full > baseline);
+    drop(buffer);
+    assert_eq!(device.work_counts().object_churn.buffers_parked, 1);
+    assert_eq!(
+        resident_blocks(&device),
+        full,
+        "recycler retains physical memory"
+    );
+    device.trim_kept_memory(Duration::ZERO);
+    assert_eq!(device.work_counts().object_churn.buffers_evicted, 1);
+    assert_eq!(
+        resident_blocks(&device),
+        baseline,
+        "one trim releases the object and allocator block"
+    );
+    // A second trim must neither double-free nor disturb recycler indexing.
+    device.trim_kept_memory(Duration::ZERO);
+    let again = device
+        .unzeroed_buffer(1 << 20, HazardTrackingMode::Default)
+        .unwrap();
+    assert_eq!(device.work_counts().object_churn.buffers_recycled, 0);
+    drop(again);
+}
+
+#[test]
+fn pressure_releases_parked_image_and_its_block() {
+    let _serial = TEST_LOCK
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let device = device();
+    device.trim_kept_memory(Duration::ZERO);
+    let baseline = resident_blocks(&device);
+    let mut descriptor = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, 256, 256, false);
+    descriptor.resource_options = ResourceOptions::private();
+    descriptor.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+    let texture = device.new_texture(&descriptor).unwrap();
+    eprintln!(
+        "image allocated: {:?}",
+        device.shared().memory.lock().unwrap().census()
+    );
+    assert!(resident_blocks(&device) > baseline);
+    drop(texture);
+    assert_eq!(device.work_counts().object_churn.images_parked, 1);
+    device.trim_kept_memory(Duration::ZERO);
+    assert_eq!(device.work_counts().object_churn.images_evicted, 1);
+    eprintln!(
+        "image trimmed: {:?}",
+        device.shared().memory.lock().unwrap().census()
+    );
+    assert_eq!(resident_blocks(&device), baseline);
+}
+
+#[test]
+fn periodic_trim_expires_idle_recycler_without_another_allocation() {
+    let _serial = TEST_LOCK
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let device = device();
+    drop(
+        device
+            .unzeroed_buffer(1 << 20, HazardTrackingMode::Default)
+            .unwrap(),
+    );
+    device.trim_kept_memory(Duration::from_secs(2));
+    assert_eq!(
+        device.work_counts().object_churn.buffers_evicted,
+        0,
+        "keep recent reuse"
+    );
+    std::thread::sleep(Duration::from_millis(1100));
+    device.trim_kept_memory(Duration::from_secs(2));
+    assert_eq!(
+        device.work_counts().object_churn.buffers_evicted,
+        1,
+        "honor recycler's one-second lifetime"
+    );
+}
+
+#[test]
+fn pressure_preserves_resources_retained_by_unsubmitted_commands() {
+    let _serial = TEST_LOCK
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let device = device();
+    let queue = device.new_command_queue().unwrap();
+    let input = device
+        .unzeroed_buffer(4096, HazardTrackingMode::Default)
+        .unwrap();
+    let output = device.new_buffer(4096, ResourceOptions::shared()).unwrap();
+    let command = queue.command_buffer().unwrap();
+    let mut blit = command.blit_command_encoder().unwrap();
+    blit.fill_buffer(&input, 0..4096, 0x5a).unwrap();
+    blit.copy_from_buffer_to_buffer(&input, 0, &output, 0, 4096)
+        .unwrap();
+    blit.end_encoding().unwrap();
+    drop(input);
+    device.trim_kept_memory(Duration::ZERO);
+    // Encoder temporaries may already be parked. The command's input must survive
+    // pressure independently of those completed allocations; verify its real GPU copy.
+    command.commit().unwrap();
+    command
+        .wait_until_completed_for(Duration::from_secs(30))
+        .unwrap();
+    assert_eq!(command.status(), CommandBufferStatus::Completed);
+    // SAFETY: the GPU copy completed; output remains owned throughout the read.
+    let data = unsafe { std::slice::from_raw_parts(output.contents().unwrap().as_ptr(), 4096) };
+    assert!(data.iter().all(|&byte| byte == 0x5a));
+}
