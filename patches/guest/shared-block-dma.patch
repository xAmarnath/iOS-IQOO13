+bool NativeVirtioBlock::configureSharedMemory(IOService *provider)
+{
+  const OSObject *property = provider->getProperty("droidvm,shared-dma");
+  if (!property) return true;
+  const OSData *window = OSDynamicCast(OSData, property);
+  if (!window || window->getLength() != 16) return false;
+  uint64_t range[2];
+  memcpy(range, window->getBytesNoCopy(), sizeof(range));
+  // This adapter's ABI uses one 4 KiB queue and one 64 KiB transfer buffer.
+  // The tree generator gives each device its own non-overlapping window.
+  if (!range[0] || (range[0] & 4095) || range[1] != 4096 + transferSize ||
+      range[0] > UINT64_MAX - range[1]) return false;
+  IODeviceMemory *memory = IODeviceMemory::withRange(range[0], range[1]);
+  if (!memory) return false;
+  sharedMapping = memory->map(kIOMapAnywhere | kIOMapCopybackCache);
+  memory->release();
+  if (!sharedMapping || sharedMapping->getLength() < range[1]) return false;
+  sharedBytes = reinterpret_cast<unsigned char *>(sharedMapping->getVirtualAddress());
+  sharedPhysical = range[0];
+  return sharedBytes != nullptr;
 }
 
